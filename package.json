{
  "name": "walgo-mcp",
  "version": "0.1.1",
  "description": "MCP server bridging an agent to a walgo-web browser tab",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "worker"
  ],
  "bin": {
    "walgo-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@walgo/mcp-protocol": "*",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "agents": {
      "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk"
    }
  }
}
