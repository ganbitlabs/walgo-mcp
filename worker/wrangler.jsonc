{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "walgo-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSIONS", "class_name": "SessionDO" },
      { "name": "COORDINATOR", "class_name": "CoordinatorDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionDO", "CoordinatorDO"]
    }
  ],
  // Rate limit on the /pair WS upgrade — the brute-force surface.
  // 10 attempts per 60s per client IP. With 8-digit codes (100M space) and
  // 5-min TTL, this makes brute-forcing one specific code statistically
  // infeasible while not blocking legitimate users (a real user only
  // /pair's once or twice).
  //
  // MINT_RATE_LIMITER caps how often a single MCP session can call
  // walgo_pair — without it, an agent can flood the Coordinator's storage
  // with thousands of one-shot codes/min. 30/60s is generous for legit use
  // (a user only re-pairs on disconnect) and ruinous for an abuser.
  "ratelimits": [
    {
      "name": "PAIR_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "MINT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
