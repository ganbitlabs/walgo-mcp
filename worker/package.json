{
  "name": "walgo-mcp-worker",
  "version": "0.1.1",
  "description": "Hosted walgo-mcp on Cloudflare Workers — bridges agents (Streamable HTTP) to a paired browser tab (WSS).",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run bundle && wrangler dev",
    "deploy": "npm run bundle && wrangler deploy",
    "bundle": "node scripts/bundle-static.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run bundle && tsc -b --noEmit",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@walgo/mcp-protocol": "*",
    "agents": "^0.12.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.3",
    "@cloudflare/workers-types": "^4.20251101.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.92.0"
  }
}
